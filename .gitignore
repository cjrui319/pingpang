# ===== 自测产物 / 缓存 =====
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# 自测输出（run.py --output 的落点，别提交）
out/
out_check_solution/
trt_cache/
*.engine
*.plan

# ===== 大文件资产：不进 Git =====
# 公开验证集：篮球 165MB + 乒乓球视频，超过 GitHub 单文件 100MB 硬限制，
# 且属于可再获取的比赛素材，不进仓库；队友/新机器另从比赛资料拷回。
participant/*/public_data/videos/
participant/*/public_data/**/*.mp4

# 自定义训练的权重：由实验产物，不进 Git（内置参考权重仍在版本控制里，
# 想改这条策略就删掉下面两行，改用 Git LFS）
participant/*/participant/weights/*.pth
participant/*/participant/weights/*.pt
participant/*/participant/models/*.onnx

# 打包提交物
*.tar
*.tar.gz
sport-base*.tar

# ===== 编辑器 / 系统 =====
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
